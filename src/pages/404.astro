---
import '../styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import bitterUrl from '@fontsource-variable/bitter/files/bitter-latin-wght-normal.woff2?url';
import bitterItalicUrl from '@fontsource-variable/bitter/files/bitter-latin-wght-italic.woff2?url';

const fuentes = `
@font-face{font-family:'Archivo';font-style:normal;font-weight:100 900;font-stretch:62% 125%;font-display:swap;src:url(${archivoUrl}) format('woff2')}
@font-face{font-family:'Bitter';font-style:normal;font-weight:100 900;font-display:swap;src:url(${bitterUrl}) format('woff2')}
@font-face{font-family:'Bitter';font-style:italic;font-weight:100 900;font-display:swap;src:url(${bitterItalicUrl}) format('woff2')}
@font-face{font-family:'Archivo Fallback';src:local('Arial');size-adjust:100%;ascent-override:88%;descent-override:22%;line-gap-override:0%}
@font-face{font-family:'Bitter Fallback';src:local('Georgia');size-adjust:97%;ascent-override:94%;descent-override:25%;line-gap-override:0%}`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Página no encontrada · Carlos Maldonado</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#F4EEDC" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style set:html={fuentes}></style>
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca-enlace" href="/" aria-label="Carlos Maldonado, inicio">
          <svg class="marca-sim" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3.75h16A1.25 1.25 0 0 1 21.25 5v11A1.25 1.25 0 0 1 20 17.25h-10l-4.5 3.5v-3.5H4A1.25 1.25 0 0 1 2.75 16V5A1.25 1.25 0 0 1 4 3.75z" fill="none" stroke="var(--tinta)" stroke-width="1.5" stroke-linejoin="round"/><path d="M2.75 10.5h18.5M12 3.75v13.5" stroke="var(--tinta)" stroke-width="1.5"/><rect x="14" y="12.5" width="5.25" height="2.75" rx=".6" fill="var(--oliva)"/></svg>
          <span class="marca" translate="no">Carlos <em>Maldonado</em></span>
          <span class="marca-desc">Automatización para pymes</span>
        </a>
      </div>
    </header>
    <main class="seccion">
      <div class="contenedor">
        <h1>Esta página no existe.</h1>
        <p class="lead"><a class="volver" href="/">Volver al inicio</a></p>
      </div>
    </main>
  </body>
</html>
