---
import '../styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import bitterUrl from '@fontsource-variable/bitter/files/bitter-latin-wght-normal.woff2?url';
import bitterItalicUrl from '@fontsource-variable/bitter/files/bitter-latin-wght-italic.woff2?url';

const titulo = 'Carlos Maldonado · Automatización para pymes';
const descripcion =
  'Automatizo la pega repetitiva de tu pyme. Registros que se llenan solos y avisos que llegan sin que los pidas, con herramientas simples y sin que cambies cómo trabajas.';
const correo = 'carlos.automatiza.tupyme@gmail.com';
const mailto = `mailto:${correo}?subject=${encodeURIComponent('Contacto desde la web')}`;
const fuentes = `
@font-face{font-family:'Archivo';font-style:normal;font-weight:100 900;font-stretch:62% 125%;font-display:swap;src:url(${archivoUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Bitter';font-style:normal;font-weight:100 900;font-display:swap;src:url(${bitterUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Bitter';font-style:italic;font-weight:100 900;font-display:swap;src:url(${bitterItalicUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Archivo Fallback';src:local('Arial');size-adjust:100%;ascent-override:88%;descent-override:22%;line-gap-override:0%}
@font-face{font-family:'Bitter Fallback';src:local('Georgia');size-adjust:97%;ascent-override:94%;descent-override:25%;line-gap-override:0%}`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href="https://carlos-maldonado578.github.io/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content="https://carlos-maldonado578.github.io/" />
    <meta name="theme-color" content="#F4EEDC" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bitterUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fuentes}></style>
  </head>
  <body id="inicio">
    <a class="salto" href="#contacto">Ir al formulario de contacto</a>

    <header class="cabecera">
      <div class="contenedor">
        <a class="marca-enlace" href="#inicio" aria-label="Carlos Maldonado, inicio">
          <svg class="marca-sim" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/><rect x="15" y="15" width="6" height="6" fill="var(--oliva)" stroke="none"/></svg>
          <span class="marca" translate="no">Carlos <em>Maldonado</em></span>
          <span class="marca-desc">Automatización para pymes</span>
        </a>
        <a class="btn btn-chico" href="#contacto">Cuéntame tu caso</a>
      </div>
    </header>

    <main>
      <section class="hero banda-tinte" aria-labelledby="t-hero">
        <div class="contenedor hero-grid">
          <div class="hero-texto">
            <p class="etiqueta">Automatización para pymes · Santiago</p>
            <h1 id="t-hero">Tu planilla se llena <em>sola</em>.</h1>
            <p class="lead">
              Tu equipo manda un mensaje y el dato queda en la planilla. Al final del día te llega el
              resumen. Yo lo armo todo.
            </p>
            <div class="hero-cta">
              <a class="btn" href="#contacto">Cuéntame tu caso</a>
              <a class="enlace-texto" href="#t-caso">Mira cómo funciona</a>
              <p class="nota">Primera conversación sin costo. Te respondo dentro de 1&nbsp;día&nbsp;hábil.</p>
            </div>
          </div>

          <div class="hero-ilus">
            <svg class="ilus ilus-v" viewBox="0 0 340 470" role="img" aria-label="Mensajes de Telegram, un formulario o el correo llegan a una planilla de Google, y de la planilla salen un resumen y un aviso."><g fill="none" stroke="var(--oliva)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><g class="cx" stroke-dasharray="1 7" stroke-width="2.5"><path d="M56 108C56 146 170 142 170 180"/><path d="M170 108V180"/><path d="M284 108C284 146 170 142 170 180"/><path d="M170 304C170 334 100 330 100 360"/><path d="M170 304C170 334 240 330 240 360"/></g><rect x="8" y="8" width="96" height="72" rx="8" fill="var(--salvia)"/><g transform="translate(36.0 24.0) scale(1.667)"><path d="M21 3 3 10.5l6 2.2 2.3 6.3 3.3-4 5 3.5L21 3z"/><path d="M9 12.7 21 3M11.3 19l.5-4.8"/></g><text class="et" x="56.0" y="100" text-anchor="middle">Telegram</text><rect x="122" y="8" width="96" height="72" rx="8" fill="var(--arena)"/><g transform="translate(150.0 24.0) scale(1.667)"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8"/><rect x="8" y="11" width="8" height="3" rx="1"/><path d="M8 17h4"/></g><text class="et" x="170.0" y="100" text-anchor="middle">Formulario</text><rect x="236" y="8" width="96" height="72" rx="8" fill="var(--rosa)"/><g transform="translate(264.0 24.0) scale(1.667)"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3.5 7.5 12 14l8.5-6.5"/></g><text class="et" x="284.0" y="100" text-anchor="middle">Correo</text><rect x="95" y="180" width="150" height="96" rx="8" fill="var(--hoja)" stroke-width="2.25"/><path d="M95 212.0H245M95 244.0H245M145.0 180V276M195.0 180V276"/><rect x="195.0" y="244.0" width="50.0" height="32.0" fill="var(--oliva)" fill-opacity=".2" stroke="none"/><text class="et" x="170.0" y="296" text-anchor="middle">Planilla de Google</text><rect x="40" y="360" width="120" height="72" rx="8" fill="var(--salvia)"/><g transform="translate(80.0 376.0) scale(1.667)"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 17v-3M12 17v-6M15 17v-4"/></g><text class="et" x="100.0" y="452" text-anchor="middle">Resumen</text><rect x="180" y="360" width="120" height="72" rx="8" fill="var(--rosa)"/><g transform="translate(220.0 376.0) scale(1.667)"><path d="M12 3C8.7 3 6.5 5.4 6.5 8.8V13l-2 3.5h15l-2-3.5V8.8C17.5 5.4 15.3 3 12 3zM9.5 19.5a2.5 2.5 0 0 0 5 0"/></g><text class="et" x="240.0" y="452" text-anchor="middle">Aviso</text></g></svg><svg class="ilus ilus-h" viewBox="0 0 560 440" role="img" aria-label="Mensajes de Telegram, un formulario o el correo llegan a una planilla de Google, y de la planilla salen un resumen y un aviso."><g fill="none" stroke="var(--oliva)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><g class="cx" stroke-dasharray="1 7" stroke-width="2.5"><path d="M148 50C178 50 178 190 205 190"/><path d="M148 190H205"/><path d="M148 330C178 330 178 190 205 190"/><path d="M355 190C386 190 386 110 420 110"/><path d="M355 190C386 190 386 270 420 270"/></g><rect x="8" y="8" width="140" height="84" rx="8" fill="var(--salvia)"/><g transform="translate(54.0 26.0) scale(2.000)"><path d="M21 3 3 10.5l6 2.2 2.3 6.3 3.3-4 5 3.5L21 3z"/><path d="M9 12.7 21 3M11.3 19l.5-4.8"/></g><text class="et" x="78.0" y="114" text-anchor="middle">Telegram</text><rect x="8" y="148" width="140" height="84" rx="8" fill="var(--arena)"/><g transform="translate(54.0 166.0) scale(2.000)"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8"/><rect x="8" y="11" width="8" height="3" rx="1"/><path d="M8 17h4"/></g><text class="et" x="78.0" y="254" text-anchor="middle">Formulario</text><rect x="8" y="288" width="140" height="84" rx="8" fill="var(--rosa)"/><g transform="translate(54.0 306.0) scale(2.000)"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3.5 7.5 12 14l8.5-6.5"/></g><text class="et" x="78.0" y="394" text-anchor="middle">Correo</text><rect x="205" y="130" width="150" height="120" rx="8" fill="var(--hoja)" stroke-width="2.25"/><path d="M205 170.0H355M205 210.0H355M255.0 130V250M305.0 130V250"/><rect x="305.0" y="210.0" width="50.0" height="40.0" fill="var(--oliva)" fill-opacity=".2" stroke="none"/><text class="et" x="280.0" y="272" text-anchor="middle">Planilla de Google</text><rect x="420" y="68" width="132" height="84" rx="8" fill="var(--salvia)"/><g transform="translate(462.0 86.0) scale(2.000)"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 17v-3M12 17v-6M15 17v-4"/></g><text class="et" x="486.0" y="174" text-anchor="middle">Resumen</text><rect x="420" y="228" width="132" height="84" rx="8" fill="var(--rosa)"/><g transform="translate(462.0 246.0) scale(2.000)"><path d="M12 3C8.7 3 6.5 5.4 6.5 8.8V13l-2 3.5h15l-2-3.5V8.8C17.5 5.4 15.3 3 12 3zM9.5 19.5a2.5 2.5 0 0 0 5 0"/></g><text class="et" x="486.0" y="334" text-anchor="middle">Aviso</text></g></svg>
          </div>
        </div>
      </section>
      <section class="seccion caso-sec" aria-labelledby="t-caso">
        <div class="contenedor">
          <div class="banda-caso">
          <h2 id="t-caso">Hoy se anota a mano. Podría anotarse solo.</h2>
          <p class="chip-real">Cliente real, datos anonimizados</p>
          {/* TODO(Carlos): agregar un dato real del caso (cuántas personas registran y cuánto tomaba juntar las hojas): un <li> dentro de .caso-datos; la lista se muestra sola cuando tiene contenido */}
          <ul class="caso-datos"></ul>
          <div class="eje" id="caso-eje">
            <div class="reloj" aria-hidden="true"><span class="cursor"></span></div>
            <p class="lectura" id="caso-hora" aria-hidden="true">08:00</p>
            <ol class="escala" aria-hidden="true">
              <li style="--h:8">08:00</li>
              <li style="--h:10">10:00</li>
              <li style="--h:12">12:00</li>
              <li style="--h:14">14:00</li>
              <li style="--h:16">16:00</li>
              <li style="--h:18">18:00</li>
              <li style="--h:20">20:00</li>
            </ol>
            <div class="carril antes">
              <h3>Antes</h3>
              <ol class="pista">
                <li class="hito" style="--h:8"><span class="hora">08:00</span><p>Cada uno anota en su hoja.</p></li>
                <li class="tramo vacio" style="--a:8;--b:17.5"><span>Sin saber cuánto se produjo.</span></li>
                <li class="hito der" style="--h:17.5"><span class="hora">17:30</span><p>Alguien junta las hojas.</p></li>
                <li class="hito der t2" style="--h:20"><span class="hora">20:00</span><p>Recién ahí sabes el total.</p></li>
              </ol>
            </div>
            <div class="carril ahora">
              <h3>Ahora</h3>
              <ol class="pista">
                <li class="hito" style="--h:8.233"><span class="hora">08:14</span><p>Juan manda “120 cajas” y la planilla se llena.</p></li>
                <li class="tramo lleno" style="--a:8.233;--b:18"><span>Ya está en la planilla.</span></li>
                <li class="hito der" style="--h:18"><span class="hora">18:00</span><p>Te llega el resumen del día.</p></li>
              </ol>
            </div>
          </div>
          <div class="caso-ctl"><button type="button" class="btn-icono" id="caso-pausa" aria-label="Pausar" title="Pausar" hidden></button></div>
          <a class="btn" href="#contacto">Cuéntame tu caso</a>
          </div>
        </div>
      </section>
      <section class="seccion servicios" aria-labelledby="t-hago">
        <div class="contenedor">
          <h2 id="t-hago">Lo mismo sirve para…</h2>
          <p class="chip-real">Ejemplo</p>
          <ul class="sv-tarjetas">
            <li class="sv-tarjeta">
              <div class="mini" aria-hidden="true">
                <div class="mi-in"><span class="burbuja">Pedido 45 despachado</span></div>
                <span class="mi-paso"></span>
                <div class="mi-out"><span class="fila"><span>Pedido 45</span><span class="chip-est">En camino</span></span></div>
              </div>
              <h3>Pedidos</h3>
              <p>Ves en qué va cada uno.</p>
            </li>
            <li class="sv-tarjeta">
              <div class="mini" aria-hidden="true">
                <div class="mi-in"><span class="fila marcada"><span>Harina · 3 sacos</span></span></div>
                <span class="mi-paso"></span>
                <div class="mi-out"><span class="burbuja aviso">Te quedan 3 sacos de harina</span></div>
              </div>
              <h3>Stock</h3>
              <p>Te avisa antes de quedarte sin.</p>
            </li>
          </ul>
        </div>
      </section>
      <section class="seccion trabajo" aria-labelledby="t-trabajo">
        <div class="contenedor">
          <h2 id="t-trabajo">Cómo trabajo</h2>
          <ol class="pasos">
            <li>
              <span class="caja sal paso-ic"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H10l-4 4v-4H4z"/></svg></span>
              <h3>Conversamos</h3>
              <p>La primera conversación es sin costo.</p>
            </li>
            <li>
              <span class="caja sal paso-ic"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/></svg></span>
              <h3>Elegimos qué automatizar</h3>
              <p>Partimos por una parte chica: lo que más tiempo te quita.</p>
            </li>
            <li>
              <span class="caja sal paso-ic"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/><rect x="8.5" y="4" width="7" height="7" rx="1"/></svg></span>
              <h3>Lo construyo</h3>
              <p>Lo pruebas con tus datos reales y apruebas lo importante.</p>
            </li>
            <li>
              <span class="caja sal paso-ic"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="m8.5 12.2 2.4 2.4 4.6-5"/></svg></span>
              <h3>Queda andando</h3>
              <p>Yo lo mantengo, por una mensualidad que conoces antes de empezar.</p>
            </li>
          </ol>
          <div class="no-hago">
            <h3>Qué no hago</h3>
            <ul>
              <li><svg class="ic no-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="m6 6 12 12"/></svg><span>No vendo software ni licencias.</span></li>
              <li><svg class="ic no-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="m6 6 12 12"/></svg><span>No te pido las claves de tu banco.</span></li>
              <li><svg class="ic no-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="m6 6 12 12"/></svg><span>No uso sistemas que te dejen sin acceso a tus datos.</span></li>
            </ul>
          </div>
        </div>
      </section>
      <section class="seccion quien" aria-labelledby="t-quien">
        <div class="contenedor quien-grid">
          <div>
            <h2 id="t-quien">Quién soy</h2>
            {/* TODO(Carlos): agregar "datos con respaldo y avisos cuando algo falla" solo cuando el respaldo nocturno de Railway esté funcionando */}
            <p class="lead">Soy Carlos Maldonado, desarrollador. Traigo a tu pyme el mismo cuidado que exige un sistema bancario.</p>
          </div>
          <ul class="ficha">
            <li><span class="caja sal"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span><span>Santiago</span></li>
            <li><span class="caja are"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9.5 12 4l9 5.5"/><path d="M5.5 10.5v7M9.5 10.5v7M14.5 10.5v7M18.5 10.5v7M3 20h18"/></svg></span><span>5 años en bancos y empresas de pagos</span></li>
            <li><span class="caja ros"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H10l-4 4v-4H4z"/></svg></span><span>Trabajo solo, hablas directo conmigo</span></li>
          </ul>
        </div>
      </section>
      <section class="seccion" aria-labelledby="t-faq">
        <div class="contenedor faq-grid">
          <div class="faq-intro">
            <h2 id="t-faq">Antes de escribirme</h2>
            <a class="faq-duda" href="#contacto">¿Tu duda no está? Escríbeme</a>
          </div>
          <div class="faq">
            <div>
              <h3>¿Cuánto cuesta?</h3>
              <p>Un pago por armarlo y una mensualidad. Te doy ambos valores antes de empezar.</p>
            </div>
            <div>
              <h3>¿De quién son los datos?</h3>
              <p>Tuyos. La planilla es tuya, sigamos trabajando juntos o no.</p>
            </div>
            <div>
              <h3>¿Necesito saber de computación?</h3>
              <p>No. Si mandas un mensaje por el celular, basta. Al entregar te dejo todo explicado por escrito.</p>
            </div>
            <div>
              <h3>¿Y si algo falla?</h3>
              <p>Lo reviso apenas me avisas. Tus datos siguen en tu planilla.</p>
            </div>
            <div>
              <h3>¿Sirve si uso Excel o WhatsApp?</h3>
              <p>Parto de lo que usas. Si no se puede conectar, te lo digo de inmediato.</p>
            </div>
            <div>
              <h3>¿Cuánto demora?</h3>
              <p>Depende de lo que necesites. Parto por una parte chica para que veas resultados pronto.</p>
            </div>
          </div>
        </div>
      </section>
      <section class="seccion" id="contacto" aria-labelledby="t-contacto">
        <div class="contenedor contacto-grid">
          <div class="contacto-texto">
            <h2 id="t-contacto">Cuéntame qué te quita tiempo</h2>
            <p class="lead">Dos líneas bastan. Te respondo en 1&nbsp;día&nbsp;hábil.</p>
            <ul class="promesas">
              <li>No tienes que preparar nada.</li>
              <li>Te digo con honestidad si te sirve.</li>
              <li>La primera conversación es sin costo.</li>
            </ul>
          </div>

          <div class="contacto-form tarjeta" id="tarjeta">
            <div id="tal-form">
              <noscript>
                <p class="sin-js">
                  Este formulario necesita JavaScript. Escríbeme directo a
                  <a href={mailto}>{correo}</a>.
                </p>
              </noscript>

              <form id="form" method="post" action="#contacto" novalidate>
                <div class="campo">
                  <label for="f-mensaje">¿Qué haces hoy a mano?</label>
                  <p class="ayuda" id="a-mensaje">Por ejemplo: anoto los pedidos a mano y después los paso a una planilla.</p>
                  <textarea id="f-mensaje" name="mensaje" rows="3" maxlength="2000" required aria-describedby="a-mensaje e-mensaje"></textarea>
                  <p class="err" id="e-mensaje" hidden></p>
                </div>

                <div class="fila-2">
                  <div class="campo">
                    <label for="f-nombre">Tu nombre</label>
                    <input id="f-nombre" name="nombre" type="text" autocomplete="name" maxlength="100" required aria-describedby="e-nombre" />
                    <p class="err" id="e-nombre" hidden></p>
                  </div>

                  <div class="campo">
                    <label for="f-contacto">¿A qué correo o teléfono te respondo?</label>
                    <input id="f-contacto" name="contacto" type="text" autocomplete="email" inputmode="email" spellcheck="false" maxlength="120" required aria-describedby="e-contacto" />
                    <p class="err" id="e-contacto" hidden></p>
                  </div>
                </div>

                <div class="hp" aria-hidden="true">
                  <label for="f-hp">No llenar</label>
                  <input id="f-hp" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <div class="fallo" id="fallo" role="alert" hidden>
                  <strong>No se pudo enviar.</strong>
                  Tu mensaje sigue en el formulario: reintenta o escríbeme a <a href={mailto}>{correo}</a>.
                </div>

                <button class="btn btn-ancho" type="submit" id="enviar">Cuéntame tu caso</button>
                <p class="nota nota-datos">Uso tus datos solo para responderte.</p>
              </form>
            </div>

            <div class="exito" id="exito" role="status" hidden>
              <h3 id="exito-t" tabindex="-1">Listo, <span id="x-nombre"></span>. Recibí tu mensaje.</h3>
              <table class="mini-planilla">
                <thead><tr><th scope="col">Hora</th><th scope="col">Estado</th></tr></thead>
                <tbody><tr class="destello"><td id="x-hora"></td><td>Recibido</td></tr></tbody>
              </table>
