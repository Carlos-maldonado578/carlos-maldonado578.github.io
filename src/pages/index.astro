---
import '../styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import bitterUrl from '@fontsource-variable/bitter/files/bitter-latin-wght-normal.woff2?url';

const titulo = 'Carlos Maldonado · Automatización para pymes';
const descripcion =
  'Automatizo la pega repetitiva de tu pyme. Registros que se llenan solos y avisos que llegan sin que los pidas, con herramientas simples y sin que cambies cómo trabajas.';
const correo = 'carlos.automatiza.tupyme@gmail.com';
const mailto = `mailto:${correo}?subject=${encodeURIComponent('Contacto desde la web')}`;
const fuentes = `
@font-face{font-family:'Archivo';font-style:normal;font-weight:100 900;font-stretch:62% 125%;font-display:swap;src:url(${archivoUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Bitter';font-style:normal;font-weight:100 900;font-display:swap;src:url(${bitterUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Archivo Fallback';src:local('Arial');size-adjust:100%;ascent-override:88%;descent-override:22%;line-gap-override:0%}
@font-face{font-family:'Bitter Fallback';src:local('Georgia');size-adjust:97%;ascent-override:94%;descent-override:25%;line-gap-override:0%}`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href="https://carlos-maldonado578.github.io/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content="https://carlos-maldonado578.github.io/" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fuentes}></style>
  </head>
  <body id="inicio">
    <a class="salto" href="#contacto">Ir al formulario de contacto</a>

    <header class="cabecera">
      <div class="contenedor">
        <p class="marca">Carlos Maldonado</p>
        <a class="btn btn-chico" href="#contacto">Conversemos</a>
      </div>
    </header>

    <main>
      <section class="hero banda-tinte" aria-labelledby="t-hero">
        <div class="contenedor hero-grid">
          <div class="hero-texto">
            <h1 id="t-hero">Automatizo la pega repetitiva de tu pyme.</h1>
            <p class="lead">
              Registros que se llenan solos y avisos que llegan sin que los pidas. Con herramientas
              simples y sin que cambies cómo trabajas.
            </p>
            <div class="hero-cta">
              <a class="btn" href="#contacto">Cuéntame tu caso</a>
              {/* TODO(Carlos): confirmar que respondes en uno o dos días */}
              <p class="nota">La primera conversación es sin costo. Te respondo en uno o dos días.</p>
            </div>
          </div>

          <div class="hero-demo">
            <figure class="hoja" id="demo">
              <div class="hoja-cab">
                <span class="rotulo">Hoja de registro · Producción</span>
                <span class="ejemplo">EJEMPLO</span>
              </div>

              <div class="paso">
                <span class="rotulo"><span class="num">1</span> Llega el mensaje</span>
                <div class="m">
                  <p class="meta" id="demo-meta">Telegram · Luis · 08:47</p>
                  <p class="mensaje on" id="demo-msg">Producción: 134&nbsp;cajas</p>
                </div>
              </div>

              <div class="paso">
                <span class="rotulo"><span class="num">2</span> Se anota en la planilla</span>
                <table>
                  <thead>
                    <tr><th scope="col">Hora</th><th scope="col">Quién</th><th scope="col">Estado</th><th scope="col">Cajas</th></tr>
                  </thead>
                  <tbody>
                    <tr><td>07:52</td><td>Pedro</td><td>Anotado</td><td>95</td></tr>
                    <tr><td>08:03</td><td>Ana</td><td>Anotado</td><td>110</td></tr>
                    <tr class="fila-nueva on"><td>08:14</td><td>Juan</td><td>Anotado</td><td>120</td></tr>
                    <tr class="fila-nueva on"><td>08:31</td><td>Marta</td><td>Anotado</td><td>98</td></tr>
                    <tr class="fila-nueva on"><td>08:47</td><td>Luis</td><td>Anotado</td><td>134</td></tr>
                  </tbody>
                </table>
              </div>

              <div class="paso">
                <span class="rotulo"><span class="num">3</span> Te llega el aviso</span>
                <p class="aviso on">Aviso · 18:00: Total del día: <b>1.240&nbsp;cajas</b></p>
              </div>

              <div class="hoja-pie">
                <figcaption>
                  Ejemplo ilustrativo con datos inventados: los trabajadores mandan un mensaje, la
                  planilla se llena sola y al final del día te llega el total.
                </figcaption>
                <button type="button" class="btn-texto" id="demo-pausa" hidden>Pausar</button>
              </div>
            </figure>
          </div>
        </div>
      </section>

      <section class="seccion problema" aria-labelledby="t-problema">
        <div class="contenedor">
          <h2 class="frase" id="t-problema">Hay una tarea que en tu pyme se hace a mano todos los días.</h2>
          <p class="lead">
            Anotar la producción en una hoja, pasar los pedidos del WhatsApp a una planilla, revisar
            qué falta despachar.
          </p>
          <p>
            Funciona, pero se te va el tiempo, los datos llegan tarde o se pierden, y te enteras de los
            problemas cuando ya no hay cómo evitarlos.
          </p>
        </div>
      </section>

      <section class="seccion pegas-sec" aria-labelledby="t-hago">
        <div class="contenedor">
          <h2 id="t-hago">Qué puedo dejar andando solo</h2>
          {/* TODO(Carlos): solo el registro por Telegram a planilla está construido para un cliente; si ya armaste pedidos, avisos o boletas, cambia el estado y la nota de honestidad de esa pega */}
          <p class="lead">
            Tomo esa parte manual y la dejo andando sola, con herramientas que ya conoces: Telegram,
            planillas, correo.
          </p>
          <div class="pegas" id="pegas">
            <p class="pegas-guia" hidden>Elige una pega y mira cómo quedaría andando.</p>
            <div class="pegas-lista" hidden>
              <button type="button" class="pega-tab" id="tab-registros" aria-controls="pega-registros">
                <span class="num">1</span>
                <span class="pega-nombre">Registros</span>
                <span class="pega-estado activo">Ya funcionando en un cliente</span>
                <span class="pega-barra" aria-hidden="true"></span>
              </button>
              <button type="button" class="pega-tab" id="tab-pedidos" aria-controls="pega-pedidos">
                <span class="num">2</span>
                <span class="pega-nombre">Pedidos</span>
                <span class="pega-estado">Lo puedo armar</span>
                <span class="pega-barra" aria-hidden="true"></span>
              </button>
              <button type="button" class="pega-tab" id="tab-avisos" aria-controls="pega-avisos">
                <span class="num">3</span>
                <span class="pega-nombre">Avisos</span>
                <span class="pega-estado">Lo puedo armar</span>
                <span class="pega-barra" aria-hidden="true"></span>
              </button>
              <button type="button" class="pega-tab" id="tab-boletas" aria-controls="pega-boletas">
                <span class="num">4</span>
                <span class="pega-nombre">Boletas y facturas</span>
                <span class="pega-estado">Lo puedo armar</span>
                <span class="pega-barra" aria-hidden="true"></span>
              </button>
            </div>

            <div class="hoja-pie pegas-pie">
              <button type="button" class="btn-texto" id="pegas-pausa" hidden>Pausar</button>
              <p class="nota">Ejemplos ilustrativos con datos inventados.</p>
            </div>

            <div class="pegas-paneles">
              <article class="pega hoja" id="pega-registros" aria-labelledby="tab-registros">
                <div class="hoja-cab"><h3 class="rotulo">Registros</h3><span class="ejemplo">EJEMPLO</span></div>
                <p class="pega-frase">Tu equipo manda un mensaje corto por Telegram y los datos caen solos en la planilla.</p>
                <div class="pega-escena escena-registros">
                  <div class="paso">
                    <span class="rotulo"><span class="num">1</span> Llega el mensaje</span>
                    <div class="m">
                      <p class="meta">Telegram · Rosa · 16:05</p>
                      <p class="mensaje on">Turno tarde: <b class="dato marcado">86</b> cajas, <b class="dato marcado">2</b> rechazadas</p>
                    </div>
                  </div>
                  <div class="paso">
                    <span class="rotulo"><span class="num">2</span> Cada dato a su columna</span>
                    <table>
                      <thead>
                        <tr><th scope="col">Hora</th><th scope="col">Quién</th><th scope="col">Cajas</th><th scope="col">Rechazo</th></tr>
                      </thead>
                      <tbody>
                        <tr><td>15:40</td><td>Pedro</td><td>92</td><td>1</td></tr>
                        <tr><td>15:52</td><td>Ana</td><td>104</td><td>0</td></tr>
                        <tr class="fila-nueva on"><td>16:05</td><td>Rosa</td><td>86</td><td>2</td></tr>
                      </tbody>
                    </table>
                  </div>
                  <p class="pega-resultado on">Anotado, sin que nadie tipee nada.</p>
                </div>
                <p class="pega-arma"><b>Cómo está armado:</b> un bot de Telegram, n8n (un programa que conecta tus apps) y una planilla de Google.</p>
                <p class="pega-honesto">Esto ya funciona en un cliente real. Los nombres y números de este ejemplo son inventados.</p>
              </article>

              <article class="pega hoja" id="pega-pedidos" aria-labelledby="tab-pedidos">
                <div class="hoja-cab"><h3 class="rotulo">Pedidos</h3><span class="ejemplo">EJEMPLO</span></div>
                <p class="pega-frase">Los pedidos que entran por formulario o WhatsApp quedan ordenados por estado, y tú ves en qué va cada uno.</p>
                <div class="pega-escena escena-pedidos">
                  <div class="tablero">
                    <div class="carril">
                      <p class="carril-t">Pendiente</p>
                      <div class="carril-lista">
                        <div class="pedido"><p>#215 · 8 bandejas</p><p class="nota">entró 09:20</p></div>
                        <div class="pedido fantasma p214"><p>#214 · 12 bandejas</p><p class="nota">entró 09:12 por formulario</p></div>
                      </div>
                    </div>
                    <div class="carril">
                      <p class="carril-t">Listo</p>
                      <div class="carril-lista">
                        <div class="pedido"><p>#211 · 20 bandejas</p></div>
                        <div class="pedido fantasma p214"><p>#214 · 12 bandejas</p><p class="nota">entró 09:12 por formulario</p></div>
                      </div>
                    </div>
                    <div class="carril">
                      <p class="carril-t">Despachado</p>
                      <div class="carril-lista">
                        <div class="pedido"><p>#209 · 6 bandejas</p></div>
                        <div class="pedido"><p>#210 · 15 bandejas</p></div>
                        <div class="pedido p214 on"><p>#214 · 12 bandejas</p><p class="nota">entró 09:12 por formulario</p></div>
                      </div>
                    </div>
                  </div>
                  <p class="aviso on">Aviso al cliente: "Tu pedido #214 va en camino."</p>
                </div>
                <p class="pega-arma"><b>Con qué lo armaría:</b> formulario o WhatsApp (si se puede conectar) para recibir el pedido, una planilla de Google para ordenarlo y n8n para moverlo y avisar por correo.</p>
                <p class="pega-honesto">Todavía no lo tengo andando en un cliente: es una muestra de cómo lo armaría para ti.</p>
              </article>

              <article class="pega hoja" id="pega-avisos" aria-labelledby="tab-avisos">
                <div class="hoja-cab"><h3 class="rotulo">Avisos</h3><span class="ejemplo">EJEMPLO</span></div>
                <p class="pega-frase">Te llega un aviso cuando el stock se está acabando o algo se atrasa, antes de que sea tarde.</p>
                <div class="pega-escena escena-avisos">
                  <div class="paso">
                    <span class="rotulo"><span class="num">1</span> Va bajando el stock</span>
                    <div class="nivel"><span>Tapas 38 mm</span><span class="nivel-cifra">180</span></div>
                    <div class="nivel-barra" style="--nivel: 180"><span class="nivel-relleno"></span><span class="nivel-min"></span></div>
                    <p class="nota nivel-nota">mínimo 200</p>
                  </div>
                  <div class="paso">
                    <span class="rotulo"><span class="num">2</span> Te llega el aviso</span>
                    <p class="aviso on">Aviso · 11:20: Quedan <b>180</b> tapas de 38 mm. El mínimo que fijaste es 200.</p>
                  </div>
                </div>
                <p class="pega-arma"><b>Con qué lo armaría:</b> tu stock en una planilla de Google, n8n que la revisa y un aviso por Telegram o correo cuando baja del mínimo.</p>
                <p class="pega-honesto">Todavía no lo tengo andando en un cliente: es una muestra de cómo lo armaría para ti.</p>
              </article>

              <article class="pega hoja" id="pega-boletas" aria-labelledby="tab-boletas">
                <div class="hoja-cab"><h3 class="rotulo">Boletas y facturas</h3><span class="ejemplo">EJEMPLO</span></div>
                <p class="pega-frase">Los datos del pedido pasan solos a la boleta o factura, sin tipear dos veces lo mismo.</p>
                <div class="pega-escena escena-boletas">
                  <div class="paso">
                    <span class="rotulo"><span class="num">1</span> Ya está en tu planilla</span>
                    <table>
                      <thead>
                        <tr><th scope="col">Pedido</th><th scope="col">Cliente</th><th scope="col">Cant.</th><th scope="col">Precio</th></tr>
                      </thead>
                      <tbody>
                        <tr><td>#214</td><td>Cliente de ejemplo</td><td>12</td><td>$3.500</td></tr>
                      </tbody>
                    </table>
                  </div>
                  <div class="paso">
                    <span class="rotulo"><span class="num">2</span> Se arma la boleta</span>
                    <div class="boleta">
                      <dl>
                        <div class="par"><dt>Cliente</dt><dd class="on">Cliente de ejemplo</dd></div>
                        <div class="par"><dt>Detalle</dt><dd class="on">Bandejas</dd></div>
                        <div class="par"><dt>Cantidad</dt><dd class="on">12</dd></div>
                        <div class="par"><dt>Precio unitario</dt><dd class="on">$3.500</dd></div>
                        <div class="par total"><dt>Total</dt><dd class="on">$42.000</dd></div>
                      </dl>
                    </div>
                  </div>
                  <p class="pega-resultado on">Lista para emitir. Tú la revisas y apruebas.</p>
                </div>
                <p class="pega-arma"><b>Con qué lo armaría:</b> n8n pasa los datos de tu planilla a un borrador de boleta; tú lo revisas y lo emites desde tu sistema de facturación.</p>
                <p class="pega-honesto">Todavía no lo tengo andando en un cliente: es una muestra de cómo lo armaría para ti.</p>
              </article>
            </div>

            <a class="enlace-texto pegas-cierre" href="#contacto">¿Tienes otra pega repetitiva? Cuéntamela.</a>
          </div>
        </div>
      </section>

      <section class="seccion trabajo" aria-labelledby="t-trabajo">
        <div class="contenedor">
          <h2 id="t-trabajo">Cómo trabajo</h2>
          {/* TODO(Carlos): confirmar duraciones aproximadas (30 a 45 min, 10 min) y que la primera conversación puede ser por llamada o en el local del cliente */}
          <ol class="pasos">
            <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 4h12v8H8l-3 3v-3H3z"/><path d="M18 9h3v8h-2v3l-3-3h-5v-2"/></svg>
              <h3>Conversamos y miro tu proceso</h3>
              <div class="yo"><p class="lado">Yo hago</p><p>Te digo con honestidad si te sirve o no. Sin costo.</p></div>
              <div class="tu"><p class="lado">Tú haces</p><p>Me cuentas cómo lo hacen hoy (30 a 45 minutos, por llamada o en tu local).</p></div>
            </li>
            <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 5h4v4H3zM10 7h11M3 15h4M10 15h11M3 20h4M10 20h11"/><path d="m3.8 7 1 1 1.6-2"/></svg>
              <h3>Te propongo qué automatizar primero</h3>
              <div class="yo"><p class="lado">Yo hago</p><p>Parto por lo que más te molesta, no por lo más vistoso.</p></div>
              <div class="tu"><p class="lado">Tú haces</p><p>Me dices si esa es la parte que quieres probar primero.</p></div>
            </li>
            <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 4h18v16H3zM3 9h18M3 14h18M9 9v11"/><path d="M12 17h6" stroke-width="2.5"/></svg>
              <h3>Construyo esa primera parte</h3>
              <div class="yo"><p class="lado">Yo hago</p><p>La armo en tus propias cuentas.</p></div>
              <div class="tu"><p class="lado">Tú haces</p><p>Me prestas unos 10 minutos para probarla con tus datos reales.</p></div>
            </li>
            <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 3h10l4 4v14H5z"/><path d="M15 3v4h4M8.5 14l2.5 2.5 4.5-5"/></svg>
              <h3>Queda funcionando</h3>
              <div class="yo"><p class="lado">Yo hago</p><p>Si quieres, sigo con las demás partes y con mantención mensual.</p></div>
              <div class="tu"><p class="lado">Tú haces</p><p>La usas, y me avisas si algo no calza.</p></div>
            </li>
          </ol>
          <p class="frase-chica">Cada parte toma semanas, no meses: ves resultados antes de gastar todo.</p>

          {/* TODO(Carlos): confirmar que estos límites son verdad para ti */}
          <div class="no-hago">
            <h3>Qué no hago</h3>
            <ul>
              <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7l8-4 8 4v10l-8 4-8-4zM4 7l8 4 8-4M12 11v10"/></svg>Vender software ni licencias.</li>
              <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16v15H4zM4 10h16M8 3v4M16 3v4M9 15h6"/></svg>Amarrarte a un plan mensual: la mantención es solo si tú la quieres.</li>
              <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4M12 15v2"/></svg>Tocar tu contabilidad ni tus claves del banco.</li>
              <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8h14l-3-3M20 16H6l3 3"/></svg>Pedirte que cambies cómo trabajas.</li>
            </ul>
          </div>
          <p class="trabajo-cta"><a class="btn" href="#contacto">Cuéntame qué te quita tiempo</a></p>
        </div>
      </section>

      <section class="seccion banda-azul" aria-labelledby="t-caso">
        <div class="contenedor">
          <h2 id="t-caso">Un caso real: el mismo día, antes y ahora</h2>
          <div class="eje">
            <ol class="escala" aria-hidden="true">
              <li style="--h:8">08:00</li>
              <li style="--h:10">10:00</li>
              <li style="--h:12">12:00</li>
              <li style="--h:14">14:00</li>
              <li style="--h:16">16:00</li>
              <li style="--h:18">18:00</li>
              <li style="--h:20">20:00</li>
            </ol>
            <div class="carril antes">
              <h3>Antes</h3>
              <ol class="pista">
                <li class="hito" style="--h:8"><span class="hora">08:00</span><p>Cada persona anota en su hoja.</p></li>
                <li class="tramo vacio" style="--a:8;--b:17.5"><span>Sin saber cuánto se produjo.</span></li>
                <li class="hito der" style="--h:17.5"><span class="hora">17:30</span><p>Alguien junta todas las hojas.</p></li>
                <li class="hito der t2" style="--h:20"><span class="hora">20:00</span><p>El dueño recién sabe el total del día.</p></li>
              </ol>
            </div>
            <div class="carril ahora">
              <h3>Ahora</h3>
              <ol class="pista">
                <li class="hito" style="--h:8.233"><span class="hora">08:14</span><p>Juan manda "120 cajas" por Telegram y la planilla se llena sola.</p></li>
                <li class="tramo lleno" style="--a:8.233;--b:18"><span>Ya está en la planilla.</span></li>
                <li class="hito der" style="--h:18"><span class="hora">18:00</span><p>El dueño recibe el resumen del día sin pedirlo.</p></li>
              </ol>
            </div>
          </div>
          {/* TODO(Carlos): confirmar herramientas reales del caso (bot de Telegram, planilla de Google, n8n) */}
          <p class="armado">Lo que hubo que armar: un bot de Telegram y una planilla de Google, unidos con n8n.</p>
          <p class="aprox nota">Cliente anónimo. Las horas son aproximadas y los nombres, de ejemplo.</p>
          <a class="btn btn-claro" href="#contacto">Cuéntame tu caso</a>
        </div>
      </section>

      <section class="seccion banda-tinte" aria-labelledby="t-faq">
        <div class="contenedor">
          <h2 id="t-faq">Antes de escribirme</h2>
          {/* TODO(Carlos): confirmar cada respuesta (qué pasa si algo se cae, qué explicas al entregar) */}
          <div class="faq">
            <details>
              <summary>¿Tengo que saber de computación?</summary>
              <p>No. Si sabes mandar un mensaje desde el celular, basta. Yo armo todo y te explico cómo usarlo, en palabras simples.</p>
            </details>
            <details>
              <summary>¿Qué pasa si algo se cae?</summary>
              <p>Me escribes y lo reviso. Tu planilla y tus datos siguen siendo tuyos, así que puedes seguir anotando a mano mientras tanto. Cómo lo resolvemos y en cuánto tiempo lo dejamos claro antes de empezar.</p>
            </details>
            <details>
              <summary>¿Mis datos, de quién son?</summary>
              <p>Tuyos. Todo queda en tus cuentas: tu planilla, tu bot, tu correo. Si un día no quieres seguir conmigo, te llevas lo tuyo.</p>
            </details>
            <details>
              <summary>¿Y si ya uso Excel o WhatsApp?</summary>
              <p>Parto de lo que ya usas y no te pido cambiar cómo trabajas. Si tu Excel o tu WhatsApp se pueden conectar, lo hago; si no, te lo digo desde el principio.</p>
            </details>
          </div>
        </div>
      </section>

      <section class="seccion banda-tinte quien" aria-labelledby="t-quien">
        <div class="contenedor">
          <h2 id="t-quien">Quién soy</h2>
          {/* TODO(Carlos): confirmar/ajustar quién soy (dónde estás, de dónde viene tu experiencia) */}
          <div class="quien-texto">
            <p>Soy Carlos Maldonado. Automatizo procesos de pymes con n8n, Telegram y planillas.</p>
            <p>Trabajo solo, sin agencia: hablas directo conmigo, de la primera conversación a que quede andando.</p>
            <p>Todo lo que armo queda en tus cuentas.</p>
          </div>
        </div>
      </section>

      <section class="seccion banda-tinte" id="contacto" aria-labelledby="t-contacto">
        <div class="contenedor contacto-grid">
          <div class="contacto-texto">
            <h2 id="t-contacto">Cuéntame qué te quita tiempo</h2>
            <p class="prueba">Ya tengo funcionando el registro por Telegram a planilla en una pyme. <a href="#t-caso">Mira el caso</a>.</p>
            <ul class="promesas">
              <li><strong>Empiezo por lo que te duele hoy.</strong><p>No te armo un sistema gigante que no pediste.</p></li>
              <li><strong>Lo dejo simple.</strong><p>Si no lo puedes usar sin mí, algo hice mal.</p></li>
              <li><strong>Todo queda en tus cuentas.</strong><p>Tu planilla, tu bot, tu correo. Si un día no quieres seguir conmigo, te llevas lo tuyo.</p></li>
              <li><strong>Cada proyecto se cotiza aparte.</strong><p>Según lo que necesites; no hay plan cerrado ni precio de lista.</p></li>
            </ul>
          </div>

          <div class="contacto-form tarjeta" id="tarjeta">
            <div id="tal-form">
              <p class="intro-form">Son tres datos, todos necesarios.</p>

              <noscript>
                <p class="sin-js">
                  Este formulario necesita JavaScript. Escríbeme directo a
                  <a href={mailto}>{correo}</a>.
                </p>
              </noscript>

              <form id="form" method="post" action="#contacto" novalidate>
                <div class="campo">
                  <label for="f-mensaje">¿Qué te gustaría sacarte de encima?</label>
                  <p class="ayuda" id="a-mensaje">Por ejemplo: anotamos los pedidos a mano y después los paso a una planilla.</p>
                  <textarea id="f-mensaje" name="mensaje" rows="4" maxlength="2000" required aria-describedby="a-mensaje e-mensaje"></textarea>
                  <p class="err" id="e-mensaje" hidden></p>
                </div>

                <div class="fila-2">
                  <div class="campo">
                    <label for="f-nombre">Tu nombre</label>
                    <input id="f-nombre" name="nombre" type="text" autocomplete="name" maxlength="100" required aria-describedby="e-nombre" />
                    <p class="err" id="e-nombre" hidden></p>
                  </div>

                  <div class="campo">
                    <label for="f-contacto">Correo o teléfono</label>
                    <p class="ayuda" id="a-contacto">Donde prefieras que te responda.</p>
                    <input id="f-contacto" name="contacto" type="text" autocomplete="email" maxlength="120" required aria-describedby="a-contacto e-contacto" />
                    <p class="err" id="e-contacto" hidden></p>
                  </div>
                </div>

                <div class="hp" aria-hidden="true">
                  <label for="f-hp">No llenar</label>
                  <input id="f-hp" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <div class="fallo" id="fallo" role="alert" hidden>
                  <strong>No se pudo enviar.</strong>
                  Escríbeme directo a <a href={mailto}>{correo}</a>
                </div>

                <button class="btn btn-ancho" type="submit" id="enviar">Enviar mensaje</button>
                {/* TODO(Carlos): confirmar plazos (uno o dos días, 30 minutos) y la frase de datos; no hay política de privacidad detrás */}
                <div class="despues">
                  <p class="despues-t">Qué pasa después de enviar</p>
                  <ol>
                    <li>Leo tu mensaje.</li>
                    <li>Te escribo con dos o tres preguntas, en uno o dos días.</li>
                    <li>Si tiene sentido, conversamos 30 minutos, sin costo.</li>
                  </ol>
                  <p class="nota">Uso tus datos solo para eso. ¿Prefieres correo? Escríbeme a <a href={mailto}>{correo}</a>.</p>
                </div>
              </form>
            </div>

            <div class="exito" id="exito" role="status" hidden>
              <h3 id="exito-t" tabindex="-1">Listo, <span id="x-nombre"></span>. Te escribo a <span id="x-contacto"></span> en uno o dos días.</h3>
              <p>Así quedó tu mensaje en mi planilla:</p>
              <table class="mini-planilla">
                <thead><tr><th scope="col">Hora</th><th scope="col">Quién</th><th scope="col">Estado</th></tr></thead>
                <tbody><tr class="destello"><td id="x-hora"></td><td id="x-quien"></td><td>Recibido</td></tr></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="contenedor">
        <span>Carlos Maldonado</span>
        <a href={mailto}>{correo}</a>
        <a href="#inicio">Volver al inicio ↑</a>
      </div>
    </footer>

    <a class="subir" href="#inicio" aria-label="Volver al inicio">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true"><path d="M12 20V5M5 11l7-7 7 7" /></svg>
    </a>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
