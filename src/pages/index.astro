---
import '../styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import bitterUrl from '@fontsource-variable/bitter/files/bitter-latin-wght-normal.woff2?url';
import bitterItalicUrl from '@fontsource-variable/bitter/files/bitter-latin-wght-italic.woff2?url';

const titulo = 'Carlos Maldonado · Automatización para pymes';
const descripcion =
  'Automatizo la pega repetitiva de tu pyme. Registros que se llenan solos y avisos que llegan sin que los pidas, con herramientas simples y sin que cambies cómo trabajas.';
const correo = 'carlos.automatiza.tupyme@gmail.com';
const mailto = `mailto:${correo}?subject=${encodeURIComponent('Contacto desde la web')}`;
const fuentes = `
@font-face{font-family:'Archivo';font-style:normal;font-weight:100 900;font-stretch:62% 125%;font-display:swap;src:url(${archivoUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Bitter';font-style:normal;font-weight:100 900;font-display:swap;src:url(${bitterUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Bitter';font-style:italic;font-weight:100 900;font-display:swap;src:url(${bitterItalicUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Archivo Fallback';src:local('Arial');size-adjust:100%;ascent-override:88%;descent-override:22%;line-gap-override:0%}
@font-face{font-family:'Bitter Fallback';src:local('Georgia');size-adjust:97%;ascent-override:94%;descent-override:25%;line-gap-override:0%}`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href="https://carlos-maldonado578.github.io/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content="https://carlos-maldonado578.github.io/" />
    <meta name="theme-color" content="#F4EEDC" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bitterUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fuentes}></style>
  </head>
  <body id="inicio">
    <a class="salto" href="#contacto">Ir al formulario de contacto</a>

    <header class="cabecera">
      <div class="contenedor">
        <p class="marca" translate="no">Carlos Maldonado</p>
        <a class="btn btn-chico" href="#contacto">Cuéntame tu caso</a>
      </div>
    </header>

    <main>
      <section class="hero banda-tinte" aria-labelledby="t-hero">
        <div class="contenedor hero-grid">
          <div class="hero-texto">
            <p class="etiqueta">Automatización para pymes · Santiago</p>
            <h1 id="t-hero">Tu planilla se llena <em>sola</em>.</h1>
            <p class="lead">
              Tu equipo manda un mensaje por Telegram, los datos caen en una planilla de Google y al
              final del día te llega el resumen. Lo armo yo, con herramientas que ya conoces.
            </p>
            <div class="hero-cta">
              <a class="btn" href="#contacto">Cuéntame tu caso</a>
              <a class="enlace-texto" href="#demo">Mira cómo funciona</a>
              <p class="nota">Primera conversación sin costo. Te respondo dentro de 1&nbsp;día&nbsp;hábil.</p>
            </div>
          </div>

          <div class="hero-demo">
            <figure class="hoja" id="demo">
              <div class="hoja-cab">
                <span class="rotulo">Hoja de registro · Producción</span>
                <span class="ejemplo">EJEMPLO</span>
              </div>

              <div class="paso">
                <span class="rotulo"><span class="num">1</span> Llega el mensaje</span>
                <div class="m">
                  <p class="meta" id="demo-meta">Telegram · Luis · 08:47</p>
                  <p class="mensaje on" id="demo-msg">Producción: 134&nbsp;cajas</p>
                </div>
              </div>

              <div class="paso">
                <span class="rotulo"><span class="num">2</span> Se anota en la planilla</span>
                <table>
                  <thead>
                    <tr><th scope="col">Hora</th><th scope="col">Quién</th><th scope="col">Estado</th><th scope="col">Cajas</th></tr>
                  </thead>
                  <tbody>
                    <tr><td>07:52</td><td>Pedro</td><td>Anotado</td><td>95</td></tr>
                    <tr><td>08:03</td><td>Ana</td><td>Anotado</td><td>110</td></tr>
                    <tr class="fila-nueva on"><td>08:14</td><td>Juan</td><td>Anotado</td><td>120</td></tr>
                    <tr class="fila-nueva on"><td>08:31</td><td>Marta</td><td>Anotado</td><td>98</td></tr>
                    <tr class="fila-nueva on"><td>08:47</td><td>Luis</td><td>Anotado</td><td>134</td></tr>
                  </tbody>
                </table>
              </div>

              <div class="paso">
                <span class="rotulo"><span class="num">3</span> Te llega el aviso</span>
                <p class="aviso on">Aviso · 18:00: Total del día: <b>1.240&nbsp;cajas</b></p>
              </div>

              <div class="hoja-pie">
                <figcaption>
                  Ejemplo ilustrativo con datos inventados: los trabajadores mandan un mensaje, la
                  planilla se llena sola y al final del día te llega el total.
                </figcaption>
                <button type="button" class="btn-texto" id="demo-pausa" hidden>Pausar</button>
              </div>
            </figure>
          </div>
        </div>
      </section>
      <section class="seccion problema" aria-labelledby="t-problema">
        <div class="contenedor">
          <h2 class="frase" id="t-problema">Hay una tarea que en tu pyme se hace a mano todos los días.</h2>
          <p class="lead">
            Anotar la producción en una hoja, pasar los pedidos del WhatsApp a una planilla, revisar
            qué falta despachar.
          </p>
          <p>
            Funciona, pero cuesta tiempo. Los datos llegan tarde o se pierden, y te enteras de los
            problemas cuando ya no hay cómo evitarlos.
          </p>
          <ul class="tarjetas">
            <li class="tarj t-salvia">Se anota en papel o en WhatsApp</li>
            <li class="tarj t-arena">Se pasa a mano a una planilla</li>
            <li class="tarj t-rosa">Te enteras tarde</li>
          </ul>
        </div>
      </section>
      <section class="seccion pegas-sec" aria-labelledby="t-hago">
        <div class="contenedor">
          <h2 id="t-hago">Qué dejo andando solo</h2>
          <p class="lead">
            Tomo la parte manual y la dejo funcionando con Telegram, planillas de Google y correo.
          </p>
          <div class="flujo" role="img" aria-label="Un mensaje por Telegram, correo o formulario llega a una planilla, y de la planilla sale un aviso.">
            <svg viewBox="0 0 760 130" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="8" y="15" width="204" height="100" rx="8" />
              <g transform="translate(24 41) scale(2)"><path d="M21 3 3 10.5l6 2.2 2.3 6.3 3.3-4 5 3.5L21 3z" /><path d="M9 12.7 21 3M11.3 19l.5-4.8" /></g>
              <g transform="translate(88 41) scale(2)"><rect x="3" y="6" width="18" height="13" rx="2" /><path d="M3.5 7.5 12 14l8.5-6.5" /></g>
              <g transform="translate(152 41) scale(2)"><path d="M4 5h16v11h-9.5L6 19.5V16H4z" /><path d="M8 9h8M8 12h5" /></g>
              <path d="M230 65h66m-10-8 10 8-10 8" />
              <rect x="316" y="10" width="170" height="110" rx="8" />
              <path d="M316 47h170M316 83h170M373 10v110M430 10v110" />
              <rect x="431" y="84" width="54" height="35" fill="currentColor" fill-opacity=".18" stroke="none" />
              <path d="M504 65h66m-10-8 10 8-10 8" />
              <rect x="594" y="25" width="158" height="80" rx="8" />
              <g transform="translate(649 41) scale(2)"><path d="M12 3C8.7 3 6.5 5.4 6.5 8.8V13l-2 3.5h15l-2-3.5V8.8C17.5 5.4 15.3 3 12 3zM9.5 19.5a2.5 2.5 0 0 0 5 0" /></g>
            </svg>
          </div>
          <div class="pegas" id="pegas">
            <p class="pegas-guia" hidden>Elige un servicio y mira cómo quedaría andando.</p>
            <div class="pegas-lista" hidden>
              <button type="button" class="pega-tab" id="tab-registros" aria-controls="pega-registros">
                <span class="num">01</span>
                <span class="pega-nombre">Registros</span>
                <span class="pega-estado activo">Funcionando en un cliente</span>
                <span class="pega-barra" aria-hidden="true"></span>
              </button>
              <button type="button" class="pega-tab" id="tab-pedidos" aria-controls="pega-pedidos">
                <span class="num">02</span>
                <span class="pega-nombre">Pedidos</span>
                <span class="pega-estado">Lo construyo para ti</span>
                <span class="pega-barra" aria-hidden="true"></span>
              </button>
              <button type="button" class="pega-tab" id="tab-avisos" aria-controls="pega-avisos">
                <span class="num">03</span>
                <span class="pega-nombre">Avisos</span>
                <span class="pega-estado">Lo construyo para ti</span>
                <span class="pega-barra" aria-hidden="true"></span>
              </button>
              <button type="button" class="pega-tab" id="tab-boletas" aria-controls="pega-boletas">
                <span class="num">04</span>
                <span class="pega-nombre">Boletas y facturas</span>
                <span class="pega-estado">Lo construyo para ti</span>
                <span class="pega-barra" aria-hidden="true"></span>
              </button>
            </div>

            <div class="hoja-pie pegas-pie">
              <button type="button" class="btn-texto" id="pegas-pausa" hidden>Pausar</button>
              <p class="nota">Ejemplos ilustrativos con datos inventados.</p>
            </div>

            <div class="pegas-paneles">
              <article class="pega hoja" id="pega-registros" aria-labelledby="tab-registros">
                <div class="hoja-cab"><h3 class="rotulo">01 · Registros</h3><span class="ejemplo">EJEMPLO</span></div>
                <p class="pega-titular">Llega el mensaje. La planilla se llena sola.</p>
                <dl class="ficha"><div><dt class="etiqueta">Entra por</dt><dd>Telegram</dd></div><div><dt class="etiqueta">Queda en</dt><dd>Planilla de Google</dd></div><div><dt class="etiqueta">Te avisa</dt><dd>Resumen diario</dd></div></dl>
                <div class="pega-escena escena-registros">
                  <div class="paso">
                    <span class="rotulo"><span class="num">1</span> Llega el mensaje</span>
                    <div class="m">
                      <p class="meta">Telegram · Rosa · 16:05</p>
                      <p class="mensaje on">Turno tarde: <b class="dato marcado">86</b> cajas, <b class="dato marcado">2</b> rechazadas</p>
                    </div>
                  </div>
                  <div class="paso">
                    <span class="rotulo"><span class="num">2</span> Cada dato a su columna</span>
                    <table>
                      <thead>
                        <tr><th scope="col">Hora</th><th scope="col">Quién</th><th scope="col">Cajas</th><th scope="col">Rechazo</th></tr>
                      </thead>
                      <tbody>
                        <tr><td>15:40</td><td>Pedro</td><td>92</td><td>1</td></tr>
                        <tr><td>15:52</td><td>Ana</td><td>104</td><td>0</td></tr>
                        <tr class="fila-nueva on"><td>16:05</td><td>Rosa</td><td>86</td><td>2</td></tr>
                      </tbody>
                    </table>
                  </div>
                  <p class="pega-resultado on">Anotado, sin que nadie tipee nada.</p>
                </div>
                <p class="pega-arma"><b>Cómo está armado:</b> un bot de Telegram, una planilla de Google y un programa que las conecta (se llama n8n).</p>
                <p class="pega-honesto">Esto ya funciona en un cliente real. Los nombres y números de este ejemplo son inventados.</p>
              </article>

              <article class="pega hoja" id="pega-pedidos" aria-labelledby="tab-pedidos">
                <div class="hoja-cab"><h3 class="rotulo">02 · Pedidos</h3><span class="ejemplo">EJEMPLO</span></div>
                <p class="pega-titular">Entra el pedido. Ves en qué va cada uno.</p>
                <dl class="ficha"><div><dt class="etiqueta">Entra por</dt><dd>Formulario (WhatsApp si se puede conectar)</dd></div><div><dt class="etiqueta">Queda en</dt><dd>Planilla ordenada por estado</dd></div><div><dt class="etiqueta">Te avisa</dt><dd>Correo al cliente</dd></div></dl>
                <div class="pega-escena escena-pedidos">
                  <div class="tablero">
                    <div class="carril">
                      <p class="carril-t">Pendiente</p>
                      <div class="carril-lista">
                        <div class="pedido"><p>#215 · 8 bandejas</p><p class="nota">entró 09:20</p></div>
                        <div class="pedido fantasma p214"><p>#214 · 12 bandejas</p><p class="nota">entró 09:12 por formulario</p></div>
                      </div>
                    </div>
                    <div class="carril">
                      <p class="carril-t">Listo</p>
                      <div class="carril-lista">
                        <div class="pedido"><p>#211 · 20 bandejas</p></div>
                        <div class="pedido fantasma p214"><p>#214 · 12 bandejas</p><p class="nota">entró 09:12 por formulario</p></div>
                      </div>
                    </div>
                    <div class="carril">
                      <p class="carril-t">Despachado</p>
                      <div class="carril-lista">
                        <div class="pedido"><p>#209 · 6 bandejas</p></div>
                        <div class="pedido"><p>#210 · 15 bandejas</p></div>
                        <div class="pedido p214 on"><p>#214 · 12 bandejas</p><p class="nota">entró 09:12 por formulario</p></div>
                      </div>
                    </div>
                  </div>
                  <p class="aviso on">Aviso al cliente: “Tu pedido #214 va en camino.”</p>
                </div>
                <p class="pega-arma"><b>Con qué lo armaría:</b> formulario o WhatsApp (si se puede conectar) para recibir el pedido, una planilla de Google para ordenarlo y un programa de conexión (n8n) para moverlo y avisar por correo.</p>
                <p class="pega-honesto">Todavía no lo tengo andando en un cliente: es una muestra de cómo lo construiría para ti.</p>
              </article>

              <article class="pega hoja" id="pega-avisos" aria-labelledby="tab-avisos">
                <div class="hoja-cab"><h3 class="rotulo">03 · Avisos</h3><span class="ejemplo">EJEMPLO</span></div>
                <p class="pega-titular">Baja el stock. Te avisan antes de quedarte sin.</p>
                <dl class="ficha"><div><dt class="etiqueta">Entra por</dt><dd>Tu planilla de stock</dd></div><div><dt class="etiqueta">Queda en</dt><dd>Esa misma planilla</dd></div><div><dt class="etiqueta">Te avisa</dt><dd>Telegram o correo bajo el mínimo</dd></div></dl>
                <div class="pega-escena escena-avisos">
                  <div class="paso">
                    <span class="rotulo"><span class="num">1</span> Va bajando el stock</span>
                    <div class="nivel"><span>Tapas 38 mm</span><span class="nivel-cifra">180</span></div>
                    <div class="nivel-barra" style="--nivel: 180"><span class="nivel-relleno"></span><span class="nivel-min"></span></div>
                    <p class="nota nivel-nota">mínimo 200</p>
                  </div>
                  <div class="paso">
                    <span class="rotulo"><span class="num">2</span> Te llega el aviso</span>
                    <p class="aviso on">Aviso · 11:20: Quedan <b>180</b> tapas de 38 mm. El mínimo que fijaste es 200.</p>
                  </div>
                </div>
                <p class="pega-arma"><b>Con qué lo armaría:</b> tu stock en una planilla de Google, un programa de conexión (n8n) que la revisa y un aviso por Telegram o correo cuando baja del mínimo.</p>
                <p class="pega-honesto">Todavía no lo tengo andando en un cliente: es una muestra de cómo lo construiría para ti.</p>
              </article>

              <article class="pega hoja" id="pega-boletas" aria-labelledby="tab-boletas">
                <div class="hoja-cab"><h3 class="rotulo">04 · Boletas y facturas</h3><span class="ejemplo">EJEMPLO</span></div>
                <p class="pega-titular">Está en tu planilla. El borrador se arma solo.</p>
                <dl class="ficha"><div><dt class="etiqueta">Entra por</dt><dd>Tu planilla</dd></div><div><dt class="etiqueta">Queda en</dt><dd>Un borrador listo</dd></div><div><dt class="etiqueta">Te avisa</dt><dd>Tú lo revisas y lo emites</dd></div></dl>
                <div class="pega-escena escena-boletas">
                  <div class="paso">
                    <span class="rotulo"><span class="num">1</span> Ya está en tu planilla</span>
                    <table>
                      <thead>
                        <tr><th scope="col">Pedido</th><th scope="col">Cliente</th><th scope="col">Cant.</th><th scope="col">Precio</th></tr>
                      </thead>
                      <tbody>
                        <tr><td>#214</td><td>Cliente de ejemplo</td><td>12</td><td>$3.500</td></tr>
                      </tbody>
                    </table>
                  </div>
                  <div class="paso">
                    <span class="rotulo"><span class="num">2</span> Se arma la boleta</span>
                    <div class="boleta">
                      <dl>
                        <div class="par"><dt>Cliente</dt><dd class="on">Cliente de ejemplo</dd></div>
                        <div class="par"><dt>Detalle</dt><dd class="on">Bandejas</dd></div>
                        <div class="par"><dt>Cantidad</dt><dd class="on">12</dd></div>
                        <div class="par"><dt>Precio unitario</dt><dd class="on">$3.500</dd></div>
                        <div class="par total"><dt>Total</dt><dd class="on">$42.000</dd></div>
                      </dl>
                    </div>
                  </div>
                  <p class="pega-resultado on">Lista para emitir. Tú la revisas y apruebas.</p>
                </div>
                <p class="pega-arma"><b>Con qué lo armaría:</b> un programa de conexión (n8n) pasa los datos de tu planilla a un borrador de boleta; tú lo revisas y lo emites en el SII. No me integro con el SII.</p>
                <p class="pega-honesto">Todavía no lo tengo andando en un cliente: es una muestra de cómo lo construiría para ti.</p>
              </article>
            </div>

            <a class="btn pegas-cierre" href="#contacto">Cuéntame tu caso</a>
          </div>
        </div>
      </section>
      <section class="seccion banda-azul" aria-labelledby="t-caso">
        <div class="contenedor">
          <h2 id="t-caso">Un caso real: el mismo día, antes y ahora</h2>
          {/* TODO(Carlos): agregar un dato real del caso (cuántas personas registran y cuánto tomaba juntar las hojas): un <li> dentro de .caso-datos; la lista se muestra sola cuando tiene contenido */}
          <ul class="caso-datos"></ul>
          <div class="eje" id="caso-eje">
            <div class="reloj" aria-hidden="true"><span class="cursor"></span></div>
            <p class="lectura" id="caso-hora" aria-hidden="true">08:00</p>
            <ol class="escala" aria-hidden="true">
              <li style="--h:8">08:00</li>
              <li style="--h:10">10:00</li>
              <li style="--h:12">12:00</li>
              <li style="--h:14">14:00</li>
              <li style="--h:16">16:00</li>
              <li style="--h:18">18:00</li>
              <li style="--h:20">20:00</li>
            </ol>
            <div class="carril antes">
              <h3>Antes</h3>
              <ol class="pista">
                <li class="hito" style="--h:8"><span class="hora">08:00</span><p>Cada persona anota en su hoja.</p></li>
                <li class="tramo vacio" style="--a:8;--b:17.5"><span>Sin saber cuánto se produjo.</span></li>
                <li class="hito der" style="--h:17.5"><span class="hora">17:30</span><p>Alguien junta todas las hojas.</p></li>
                <li class="hito der t2" style="--h:20"><span class="hora">20:00</span><p>El dueño recién sabe el total del día.</p></li>
              </ol>
            </div>
            <div class="carril ahora">
              <h3>Ahora</h3>
              <ol class="pista">
                <li class="hito" style="--h:8.233"><span class="hora">08:14</span><p>Juan manda “120 cajas” por Telegram y la planilla se llena sola.</p></li>
                <li class="tramo lleno" style="--a:8.233;--b:18"><span>Ya está en la planilla.</span></li>
                <li class="hito der" style="--h:18"><span class="hora">18:00</span><p>El dueño recibe el resumen del día automáticamente.</p></li>
              </ol>
            </div>
          </div>
          <div class="caso-ctl"><button type="button" class="btn-icono" id="caso-pausa" aria-label="Pausar" title="Pausar" hidden></button></div>
          <a class="btn btn-claro" href="#contacto">Cuéntame tu caso</a>
        </div>
      </section>
      <section class="seccion principios" aria-labelledby="t-principios">
        <div class="contenedor">
          <h2 id="t-principios">Tres principios</h2>
          <ul class="principios-lista">
            <li>
              <h3>Conectado a lo que ya usas</h3>
              <p>Parto de tu planilla, tu Telegram y tu correo. No tienes que aprender un sistema nuevo.</p>
            </li>
            <li>
              <h3>Hecho a tu forma de trabajar</h3>
              <p>Miro cómo trabajas hoy y automatizo eso.</p>
            </li>
            <li>
              <h3>Tú decides</h3>
              <p>Tú eliges qué se automatiza y qué revisas tú antes de que salga. Las boletas, por ejemplo, las apruebas tú.</p>
            </li>
          </ul>
        </div>
      </section>
      <section class="seccion trabajo" aria-labelledby="t-trabajo">
        <div class="contenedor">
          <h2 id="t-trabajo">Cómo trabajo</h2>
          <ol class="pasos">
            <li>
              <h3>Conversamos</h3>
              <div class="yo"><p class="lado">Yo hago</p><p>Miro tu proceso y te digo si te sirve, por llamada o videollamada. Sin costo.</p></div>
              <div class="tu"><p class="lado">Tú haces</p><p>Me cuentas cómo trabajas hoy.</p></div>
            </li>
            <li>
              <h3>Te propongo por dónde partir</h3>
              <div class="yo"><p class="lado">Yo hago</p><p>Parto por lo que más te molesta.</p></div>
              <div class="tu"><p class="lado">Tú haces</p><p>Me dices si esa es la parte que quieres probar.</p></div>
            </li>
            <li>
              <h3>Construyo la primera parte</h3>
              <div class="yo"><p class="lado">Yo hago</p><p>La armo y la dejo andando.</p></div>
              <div class="tu"><p class="lado">Tú haces</p><p>La pruebas con tus datos reales.</p></div>
            </li>
            <li>
              <h3>Queda funcionando</h3>
              <div class="yo"><p class="lado">Yo hago</p><p>Lo dejo andando en un servidor en la nube y lo cuido.</p></div>
              <div class="tu"><p class="lado">Tú haces</p><p>Lo usas y me avisas si algo no calza. Pagas una mensualidad; el valor te lo digo antes de empezar.</p></div>
            </li>
          </ol>
          <p class="lead trabajo-cierre">El plazo depende de lo que necesites. Parto por una parte chica para que veas resultados pronto, antes de seguir con lo demás.</p>
          <div class="no-hago">
            <h3>Qué no hago</h3>
            <ul>
              <li>Vender software ni licencias.</li>
              <li>Pedirte las claves de tu banco.</li>
              <li>Conectarme a sistemas que no te dejan sacar tus datos.</li>
            </ul>
          </div>
        </div>
      </section>
      <section class="seccion quien" aria-labelledby="t-quien">
        <div class="contenedor">
          <h2 id="t-quien">Quién soy</h2>
          {/* TODO(Carlos): agregar "datos con respaldo y avisos cuando algo falla" solo cuando el respaldo nocturno de Railway esté funcionando */}
          <p class="lead">
            Soy Carlos Maldonado, desarrollador en Santiago. Llevo 5 años como desarrollador backend, con
            experiencia en sistemas bancarios y fintech, donde un dato mal guardado o un aviso que no
            llega es un problema serio. Esa forma de trabajar la llevo a tu pyme.
          </p>
          <ul class="datos">
            <li>5 años como desarrollador backend</li>
            <li>Sistemas bancarios y fintech</li>
            <li>Trabajo solo, sin agencia: hablas directo conmigo</li>
            <li>Respondo en 1&nbsp;día&nbsp;hábil</li>
          </ul>
        </div>
      </section>
      <section class="seccion" aria-labelledby="t-faq">
        <div class="contenedor">
          <h2 id="t-faq">Antes de escribirme</h2>
          <div class="faq">
            <div>
              <h3>¿Tengo que saber de computación?</h3>
              <p>No. Si sabes mandar un mensaje desde el celular, basta. Yo armo todo y, al entregar, te explico cómo usarlo y te dejo la documentación por escrito.</p>
            </div>
            <div>
              <h3>¿Cuánto cuesta?</h3>
              <p>Depende de lo que necesites automatizar. En la primera conversación, que es sin costo, vemos tu caso y te doy el valor del proyecto y de la mensualidad antes de empezar. Sin sorpresas.</p>
            </div>
            <div>
              <h3>¿Qué pasa si algo se cae?</h3>
              <p>Lo reviso apenas me avisas. Tus datos siguen en tu planilla, así que mientras tanto puedes anotar a mano.</p>
            </div>
            <div>
              <h3>¿Mis datos, de quién son?</h3>
              <p>La planilla es tuya. Si un día dejamos de trabajar juntos, te la quedas con todos tus datos. Las automatizaciones corren en mi servidor en la nube.</p>
            </div>
            <div>
              <h3>¿Cuánto demoras en responder?</h3>
              <p>Te respondo dentro de 1&nbsp;día&nbsp;hábil.</p>
            </div>
            <div>
              <h3>¿Y si ya uso Excel o WhatsApp?</h3>
              <p>Parto de lo que ya usas, sin pedirte cambiar cómo trabajas. Si se puede conectar, lo hago; si no, te lo digo desde el principio.</p>
            </div>
          </div>
        </div>
      </section>
      <section class="seccion banda-tinte" id="contacto" aria-labelledby="t-contacto">
        <div class="contenedor contacto-grid">
          <div class="contacto-texto">
            <h2 id="t-contacto">Cuéntame qué te quita tiempo</h2>
            <p class="lead">Escríbeme en dos líneas qué haces hoy a mano. Te respondo dentro de 1&nbsp;día&nbsp;hábil, con una idea de si te sirve.</p>
            <div class="promesas"><p>La primera conversación es por llamada o videollamada, sin costo. Ahí vemos tu caso y te doy el valor del proyecto y de la mensualidad antes de empezar.</p></div>
          </div>

          <div class="contacto-form tarjeta" id="tarjeta">
            <div id="tal-form">
              <noscript>
                <p class="sin-js">
                  Este formulario necesita JavaScript. Escríbeme directo a
                  <a href={mailto}>{correo}</a>.
                </p>
              </noscript>

              <form id="form" method="post" action="#contacto" novalidate>
                <div class="campo">
                  <label for="f-mensaje">¿Qué haces hoy a mano?</label>
                  <p class="ayuda" id="a-mensaje">Por ejemplo: anoto los pedidos a mano y después los paso a una planilla.</p>
                  <textarea id="f-mensaje" name="mensaje" rows="3" maxlength="2000" required aria-describedby="a-mensaje e-mensaje"></textarea>
                  <p class="err" id="e-mensaje" hidden></p>
                </div>

                <div class="fila-2">
                  <div class="campo">
                    <label for="f-nombre">Tu nombre</label>
                    <input id="f-nombre" name="nombre" type="text" autocomplete="name" maxlength="100" required aria-describedby="e-nombre" />
                    <p class="err" id="e-nombre" hidden></p>
                  </div>

                  <div class="campo">
                    <label for="f-contacto">¿A qué correo o teléfono te respondo?</label>
                    <input id="f-contacto" name="contacto" type="text" autocomplete="email" inputmode="email" spellcheck="false" maxlength="120" required aria-describedby="e-contacto" />
                    <p class="err" id="e-contacto" hidden></p>
                  </div>
                </div>

                <div class="hp" aria-hidden="true">
                  <label for="f-hp">No llenar</label>
                  <input id="f-hp" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <div class="fallo" id="fallo" role="alert" hidden>
                  <strong>No se pudo enviar.</strong>
                  Tu mensaje sigue en el formulario: reintenta o escríbeme a <a href={mailto}>{correo}</a>.
                </div>

                <button class="btn btn-ancho" type="submit" id="enviar">Cuéntame tu caso</button>
                <p class="nota nota-datos">Respondo dentro de 1&nbsp;día&nbsp;hábil. Uso tus datos solo para responderte.</p>
              </form>
            </div>

            <div class="exito" id="exito" role="status" hidden>
              <h3 id="exito-t" tabindex="-1">Listo, <span id="x-nombre"></span>. Recibí tu mensaje. Te escribo a <span id="x-contacto"></span> dentro de 1&nbsp;día&nbsp;hábil.</h3>
              <p>Así quedó tu mensaje en mi planilla:</p>
              <table class="mini-planilla">
                <thead><tr><th scope="col">Hora</th><th scope="col">Quién</th><th scope="col">Estado</th></tr></thead>
                <tbody><tr class="destello"><td id="x-hora"></td><td id="x-quien"></td><td>Recibido</td></tr></tbody>
              </table>
              <p class="exito-sigue"><strong>Qué pasa ahora:</strong> leo tu mensaje, te respondo con preguntas o ideas y, si te sirve, agendamos una llamada o videollamada.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="contenedor">
        <span translate="no">Carlos Maldonado · Automatización para pymes · Santiago, Chile</span>
        <a href={mailto}>{correo}</a>
        <a href="#inicio">Volver al inicio ↑</a>
      </div>
    </footer>

    <a class="subir" href="#inicio" aria-label="Volver al inicio">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true"><path d="M12 20V5M5 11l7-7 7 7" /></svg>
    </a>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
