---
// Arnes de prototipos: pagina aislada con los mismos tokens, cabecera real y selector de variantes (PICKER.md). Nada de produccion lo importa.
import '../styles/global.css';
import './proto.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import bitterUrl from '@fontsource-variable/bitter/files/bitter-latin-wght-normal.woff2?url';
import bitterItalicUrl from '@fontsource-variable/bitter/files/bitter-latin-wght-italic.woff2?url';
const { titulo, variantes, replay = false } = Astro.props;
const fuentes = `
@font-face{font-family:'Archivo';font-style:normal;font-weight:100 900;font-stretch:62% 125%;font-display:swap;src:url(${archivoUrl}) format('woff2')}
@font-face{font-family:'Bitter';font-style:normal;font-weight:100 900;font-display:swap;src:url(${bitterUrl}) format('woff2')}
@font-face{font-family:'Bitter';font-style:italic;font-weight:100 900;font-display:swap;src:url(${bitterItalicUrl}) format('woff2')}`;
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Prototipo · {titulo}</title>
    <style set:html={fuentes}></style>
  </head>
  <body id="inicio">
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca-enlace" href="/" aria-label="Carlos Maldonado, inicio">
          <svg class="marca-sim" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/><rect x="15" y="15" width="6" height="6" fill="var(--oliva)" stroke="none"/></svg>
          <span class="marca" translate="no">Carlos <em>Maldonado</em></span>
          <span class="marca-desc">Prototipo: {titulo}</span>
        </a>
      </div>
    </header>
    <main><slot /></main>

    <nav class="proto-picker" aria-label="Prototype variants">
      <span class="proto-picker-highlight" aria-hidden="true"></span>
      {variantes.map((v: string, i: number) => <button class="proto-picker-item" {...(i === 0 ? { 'data-active': '', 'aria-current': 'true' } : {})}>{v}</button>)}
      {replay && <><span class="proto-picker-divider" aria-hidden="true"></span><button class="proto-picker-item proto-picker-replay" aria-label="Replay animation (R)">↻</button></>}
    </nav>

    <script is:inline>
      const stage = [...document.querySelectorAll('.proto-v')];
      const picker = document.querySelector('.proto-picker');
      const highlight = picker.querySelector('.proto-picker-highlight');
      const items = [...picker.querySelectorAll('.proto-picker-item:not(.proto-picker-replay)')];
      const replay = picker.querySelector('.proto-picker-replay');
      let current = 0;
      function moveHighlight() {
        const el = items[current];
        highlight.style.width = el.offsetWidth + 'px';
        highlight.style.transform = `translateX(${el.offsetLeft}px)`;
      }
      // las variantes ya estan en el HTML: montar = mostrar una y reiniciar sus entradas animadas
      function mount(i) {
        stage.forEach((s, j) => { s.hidden = j !== i; s.classList.remove('montada'); });
        requestAnimationFrame(() => stage[i].classList.add('montada'));
      }
      function setActive(i) {
        if (i < 0 || i >= stage.length) return;
        current = i;
        items.forEach((el, j) => {
          el.toggleAttribute('data-active', j === i);
          if (j === i) el.setAttribute('aria-current', 'true'); else el.removeAttribute('aria-current');
        });
        moveHighlight();
        const url = new URL(location);
        url.searchParams.set('v', i + 1);
        history.replaceState(null, '', url);
        mount(i);
      }
      items.forEach((el, i) => el.addEventListener('click', () => setActive(i)));
      replay?.addEventListener('click', () => mount(current));
      window.addEventListener('resize', moveHighlight);
      document.addEventListener('keydown', (e) => {
        if (/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable || e.target.getAttribute('role') === 'tab') return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const num = parseInt(e.key, 10);
        if (num >= 1 && num <= stage.length) setActive(num - 1);
        else if (e.key === 'ArrowRight') setActive((current + 1) % stage.length);
        else if (e.key === 'ArrowLeft') setActive((current - 1 + stage.length) % stage.length);
        else if (e.key === 'r' || e.key === 'R') mount(current);
      });
      setActive((parseInt(new URLSearchParams(location.search).get('v'), 10) || 1) - 1);
      requestAnimationFrame(() => requestAnimationFrame(() => picker.setAttribute('data-ready', '')));
    </script>
  </body>
</html>
