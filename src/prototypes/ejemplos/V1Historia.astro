---
// Variante 1 · Una sola historia (eje: estructura). Caso real y ejemplos en el mismo bloque verde.
import Eje from './Eje.astro';
import { produccion } from './datos';
---
<section class="seccion caso-sec" aria-labelledby="v1-t">
  <div class="contenedor">
    <div class="banda-caso">
      <h2 id="v1-t">Hoy se anota a mano. Podría anotarse solo.</h2>
      <p class="chip-real">Cliente real, datos anonimizados</p>
      <Eje id="v1-eje" antes={produccion.antes} ahora={produccion.ahora} />
      <div class="v1-ejemplos">
        <h3 class="rotulo-ej">Ejemplo · así se vería en tu negocio</h3>
        <ul class="v1-lista">
          <li>
            <h4>Pedidos</h4>
            <p class="v1-antes"><span>Antes</span> Te preguntan por WhatsApp en qué va el pedido.</p>
            <p class="v1-ahora"><span>Ahora</span> Lo ves en la planilla, con su estado.</p>
          </li>
          <li>
            <h4>Stock</h4>
            <p class="v1-antes"><span>Antes</span> Te enteras de que falta harina cuando ya no queda.</p>
            <p class="v1-ahora"><span>Ahora</span> Te avisan cuando quedan 3 sacos.</p>
          </li>
        </ul>
      </div>
      <a class="btn" href="/#contacto">Cuéntame tu caso</a>
    </div>
  </div>
</section>
