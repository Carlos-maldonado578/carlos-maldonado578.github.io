---
// Variante 1 · Conversacion (eje: personalidad). Preguntas como mensajes del cliente, respuestas como mensajes de Carlos.
import { preguntas } from './datos';
---
<section class="seccion" aria-labelledby="f1-t">
  <div class="contenedor faq-grid">
    <div class="faq-intro">
      <h2 id="f1-t">Antes de escribirme</h2>
      <a class="faq-duda" href="/#contacto">¿Tu duda no está? Escríbeme</a>
    </div>
    <div class="f1-conv">
      {preguntas.map((p, i) => (
        <div class="f1-par" style={`--d:${i * 70}ms`}>
          <h3 class="f1-q">{p.q}</h3>
          <p class="f1-a">{p.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>
